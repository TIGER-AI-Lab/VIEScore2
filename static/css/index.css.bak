body {
    font-family: 'Noto Sans', sans-serif;
}

p {
    font-size: 16px;
}

.content p,
.content li {
    text-align: justify;
}

.publication-title,
.publication-authors {
    font-family: 'Google Sans', sans-serif;
}

.publication-authors {
    margin-bottom: 0.5rem;
}

.affiliations {
    color: #555;
}

.affiliations .author-block {
    margin: 0 0.4rem;
}

.author-block {
    display: inline-block;
}

.publication-links {
    margin-top: 1rem;
}

.link-block a {
    margin: 5px 2px;
}

/* Figures rendered from the paper's vector PDFs */
.paper-figure {
    margin: 1.5rem auto 0;
}

.paper-figure img {
    display: block;
    width: 100%;
    height: auto;
}

.paper-figure figcaption,
.table-caption {
    max-width: 960px;
    margin: 0.75rem auto 0;
    font-size: 15px;
    color: #4a4a4a;
    text-align: justify;
}

/* Highlights */
.stats {
    margin-bottom: 1.5rem;
}

.stat-value {
    font-family: 'Google Sans', sans-serif;
    font-size: 2.5rem;
    font-weight: 700;
    color: #1f3b57;
    line-height: 1.2;
}

.stat-label {
    font-size: 14px;
    color: #555;
}

.contributions .title {
    margin-bottom: 0.5rem;
}

.contributions p {
    font-size: 15px;
}

/* Results tables */
.results-table {
    margin: 1rem auto 0;
    font-size: 14px;
}

.results-table th,
.results-table td {
    text-align: center !important;
    vertical-align: middle;
    white-space: nowrap;
}

.results-table td:first-child,
.results-table th:first-child {
    text-align: left !important;
}

.results-table tr.ours td {
    border-top: 2px solid #363636;
    background-color: #f5f9ff;
}

#BibTeX pre {
    white-space: pre-wrap;
    word-break: break-word;
}

.emails {
    background: none;
    color: inherit;
    font-size: 0.95em;
    padding: 0;
}
